# Backend
SEASCAN_ENVIRONMENT=development
SEASCAN_API_V1_PREFIX=/api
SEASCAN_CORS_ORIGINS=["http://localhost:5173"]
SEASCAN_DATABASE_URL=sqlite:///./seascan.db
SEASCAN_UPLOAD_DIRECTORY=../data/uploads
SEASCAN_PROCESSED_DIRECTORY=../data/processed
SEASCAN_MAX_UPLOAD_SIZE_MB=512
SEASCAN_AUTH_SESSION_HOURS=8
# Development-only seeded Investigator, Analyst and Administrator accounts.
# Change this before sharing any deployed development instance.
SEASCAN_DEMO_USER_PASSWORD=SeaScan@2026
# Required only for the first startup when SEASCAN_ENVIRONMENT is not development.
# SEASCAN_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-secret
# Required before satellite segmentation can return a real model output.
# Set this after training a compatible U-Net checkpoint in Phase 2.
SEASCAN_MODEL_WEIGHTS_PATH=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
